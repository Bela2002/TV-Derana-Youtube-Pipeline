# Copy this file to .env and fill in PROJECT_ID. Everything else has working defaults.
# .env is ignored by git and is never uploaded to Cloud Run.

# ---- Google Cloud --------------------------------------------------------
# Your Google Cloud project ID (Console > project picker > ID column)
PROJECT_ID=your-gcp-project-id
# Region for Cloud Run and Cloud Scheduler
REGION=us-central1
# BigQuery dataset location (US, EU, asia-south1, ...). Cannot be changed after creation.
BQ_LOCATION=US
BQ_DATASET=youtube_derana

# ---- YouTube --------------------------------------------------------------
# Leave empty: setup creates a key restricted to YouTube Data API v3 and stores it in Secret Manager.
# Fill it only to use an existing key (also needed for local runs, see README).
YOUTUBE_API_KEY=
# Channel to track. CHANNEL_ID (UC...) wins over CHANNEL_HANDLE when both are set.
CHANNEL_HANDLE=@tvderanaofficial
CHANNEL_ID=

# ---- Schedule -------------------------------------------------------------
# Cron format, interpreted in SCHEDULE_TIMEZONE. Default: every day at 00:05 Sri Lanka time,
# so each run covers the previous local calendar day.
SCHEDULE="5 0 * * *"
SCHEDULE_TIMEZONE=Asia/Colombo

# ---- Pipeline behaviour -----------------------------------------------------
# Videos published within this many days are snapshotted every day.
LOOKBACK_DAYS=90
# Shorts detection order: playlist (channel Shorts playlist), url (youtube.com/shorts check), duration
SHORTS_DETECTION=playlist,url,duration
SHORTS_MAX_SECONDS=180
# Time zone used for publish hour, time slots and report dates
REPORT_TIMEZONE=Asia/Colombo
# Playlist scanning: full scan when it needs at most this many API pages, otherwise
# only the first PLAYLIST_MAX_PAGES pages of each playlist are read.
PLAYLIST_PAGE_BUDGET=3000
PLAYLIST_MAX_PAGES=4
# A playlist is re-read when its item count changes, or at least every N days.
PLAYLIST_RESCAN_DAYS=7

# ---- Resource names (change only to run several copies in one project) ---------
SERVICE_NAME=yt-derana-pipeline
SCHEDULER_JOB=yt-derana-daily
SECRET_NAME=youtube-api-key
